using Gtk 4.0;
using Adw 1;

template $GisSummaryPage : $GisPage {
  Adw.StatusPage status_page {
    accessible-role: group;
    icon-name: "ready-to-go";
    title: _("All done!");

    Gtk.Button start_button {
      use-underline: true;
      halign: center;
      sensitive: false;

      styles [
        "suggested-action",
        "pill"
      ]
    }
  }
}