using Gtk 4.0;
using Adw 1;

template $GisAccountPageEnterprise : Adw.Bin {
  Gtk.Box area {
    orientation: vertical;
    valign: fill;

    $GisPageHeader header {
      margin-bottom: 26;
      margin-top: 24;
      title: _("Enterprise Login");
      subtitle: _("Enterprise login allows an existing centrally managed user account to be used on this device. You can also use this account to access company resources on the internet.");
      icon-name: "dialog-password-symbolic";
      show-icon: true;
    }

    Gtk.Grid form {
      row-spacing: 12;
      column-spacing: 12;
      margin-bottom: 32;

      Gtk.Label label4 {
        halign: end;
        xalign: 1;
        label: _("_Domain");
        use-underline: true;
        mnemonic-widget: domain;

        layout {
          column: 0;
          row: 1;
        }
      }

      Gtk.Label label8 {
        halign: end;
        xalign: 1;
        label: _("_Username");
        use-underline: true;
        mnemonic-widget: login;

        layout {
          column: 0;
          row: 3;
        }
      }

      Gtk.Label label9 {
        halign: end;
        xalign: 1;
        label: _("_Password");
        use-underline: true;
        mnemonic-widget: password;

        layout {
          column: 0;
          row: 4;
        }
      }

      Gtk.Entry login {
        hexpand: true;
        max-length: 255;
        width-chars: 25;

        accessibility {
          required: true;
        }

        layout {
          column: 1;
          row: 3;
        }
      }

      Gtk.PasswordEntry password {
        hexpand: true;
        width-chars: 25;

        accessibility {
          required: true;
        }

        layout {
          column: 1;
          row: 4;
        }
      }

      Gtk.ComboBox domain {
        hexpand: true;
        has-entry: true;
        entry-text-column: 0;

        accessibility {
          required: true;
        }

        layout {
          column: 1;
          row: 1;
        }
      }

      Gtk.Label label10 {
        margin-bottom: 12;
        xalign: 0;
        label: _("Enterprise domain or realm name");
        attributes: "scale 0.8";

        layout {
          column: 1;
          row: 2;
        }
      }

      Gtk.Label filler {
        layout {
          column: 2;
          row: 4;
        }
      }
    }
  }
}

Gtk.Dialog join_dialog {
  resizable: false;
  modal: true;
  destroy-with-parent: true;
  title: _("Domain Administrator Login");

  [internal-child content_area]
  Gtk.Box dialog_vbox1 {
    orientation: vertical;
    margin-top: 18;
    margin-bottom: 18;
    margin-start: 18;
    margin-end: 18;
    spacing: 10;

    Gtk.Label label12 {
      xalign: 0.5;
      yalign: 0;
      wrap: true;
      max-width-chars: 60;
      label: _("In order to use enterprise logins, this computer needs to be enrolled in a domain. Please have your network administrator type the domain password here, and choose a unique computer name for your computer.");
    }

    Gtk.Grid grid1 {
      margin-start: 12;
      hexpand: true;
      row-spacing: 6;
      column-spacing: 12;

      Gtk.Label label13 {
        xalign: 1;
        label: _("_Domain");
        use-underline: true;
        mnemonic-widget: join_domain;

        layout {
          column: 0;
          row: 0;
        }

        styles [
          "dim-label"
        ]
      }

      Gtk.Label join_domain {
        margin-top: 5;
        margin-bottom: 5;
        xalign: 0;

        layout {
          column: 1;
          row: 0;
        }
      }

      Gtk.Label label18 {
        xalign: 1;
        label: _("_Computer");
        use-underline: true;
        mnemonic-widget: join_computer;

        layout {
          column: 0;
          row: 1;
        }

        styles [
          "dim-label"
        ]
      }

      Gtk.Entry join_computer {
        hexpand: true;

        layout {
          column: 1;
          row: 1;
        }
      }

      Gtk.Label label14 {
        xalign: 1;
        label: _("Administrator _Name");
        use-underline: true;
        mnemonic-widget: join_name;

        layout {
          column: 0;
          row: 2;
        }

        styles [
          "dim-label"
        ]
      }

      Gtk.Entry join_name {
        hexpand: true;

        layout {
          column: 1;
          row: 2;
        }
      }

      Gtk.Label label15 {
        xalign: 1;
        label: _("Administrator Password");
        use-underline: true;
        mnemonic-widget: join_password;

        layout {
          column: 0;
          row: 3;
        }

        styles [
          "dim-label"
        ]
      }

      Gtk.PasswordEntry join_password {
        hexpand: true;

        layout {
          column: 1;
          row: 3;
        }
      }
    }
  }

  [action response=cancel]
  Gtk.Button button_cancel {
    label: _("_Cancel");
    use-underline: true;
  }

  [action response=ok default]
  Gtk.Button button_ok {
    label: _("C_ontinue");
    use-underline: true;

    styles [
      "suggested-action"
    ]
  }
}