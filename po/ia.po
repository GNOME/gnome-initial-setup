msgstr "Remover avatar"

#: gnome-initial-setup/pages/account/gis-account-page-local.blp:64
#: gnome-initial-setup/pages/account/gis-account-page.c:274
msgid "About You"
msgstr "Super te"

#: gnome-initial-setup/pages/account/gis-account-page-local.blp:65
msgid "Please provide a name and username. You can choose a picture too."
msgstr ""
"Forni un nomine e un nomine de usator. Anque tu pote eliger un imagine."

#: gnome-initial-setup/pages/account/gis-account-page-local.blp:73
msgid "_Full Name"
msgstr "No_mine complete"

#: gnome-initial-setup/pages/account/gis-account-page-local.blp:117
msgid "Set up _parental controls for this user"
msgstr "Configurar controlos _parental pro iste usator"

#: gnome-initial-setup/pages/account/gis-account-page-local.blp:118
msgid "For use by a parent or supervisor, who must set up their own password."
msgstr ""
"Pro uso per un parente o supervisor, qui debe configurar su proprie "
"contrasigno."

#: gnome-initial-setup/pages/account/gis-account-page.blp:23
msgid "_Enterprise Login"
msgstr "Initio de s_ession interprisal"

#: gnome-initial-setup/pages/account/gis-account-page.blp:31
msgid "Go online to set up Enterprise Login."
msgstr "Vade in linea pro configurar le Initio de session interprisal"

#: gnome-initial-setup/pages/account/um-realm-manager.c:310
msgid "Cannot automatically join this type of domain"
msgstr "Impossibile de junger se automaticamente a iste typo de dominio"

#: gnome-initial-setup/pages/account/um-realm-manager.c:374
#, c-format
msgid "No such domain or realm found"
msgstr "Necun tal dominio trovate"

#: gnome-initial-setup/pages/account/um-realm-manager.c:788
#: gnome-initial-setup/pages/account/um-realm-manager.c:802
#, c-format
msgid "Cannot log in as %s at the %s domain"
msgstr "Impossibile de connecter se como %s al dominio %s"

#: gnome-initial-setup/pages/account/um-realm-manager.c:794
msgid "Invalid password, please try again"
msgstr "Contrasigno invalide, tenta de novo"

#: gnome-initial-setup/pages/account/um-realm-manager.c:807
#, c-format
msgid "Couldn’t connect to the %s domain: %s"
msgstr "Non poteva connecter se al dominio %s: %s"

#: gnome-initial-setup/pages/account/um-utils.c:145
msgid "Sorry, that user name isn’t available. Please try another."
msgstr "Pardono, iste nomine de usator non es disponibile. Tenta altere."

#: gnome-initial-setup/pages/account/um-utils.c:148
#, c-format
msgid "The username is too long."
msgstr "Le nomine de usator es troppo longe."

#: gnome-initial-setup/pages/account/um-utils.c:151
msgid "The username must start with a lower case letter from a-z."
msgstr "Le nomine de usator debe comenciar con un littera minuscule desde a-z."

#: gnome-initial-setup/pages/account/um-utils.c:154
msgid "That username isn’t available. Please try another."
msgstr "Iste nomine de usator non es disponibile. Tenta altere"

#: gnome-initial-setup/pages/account/um-utils.c:157
msgid ""
"The username should only consist of lower case letters from a-z, digits, and "
"the following characters: - _"
msgstr ""
"Le nomine de usator solmente deberea consister de litteras minuscule desde a-"
"z, digitos e le sequente characteres: - _"

#: gnome-initial-setup/pages/account/um-utils.c:161
msgid "This will be used to name your home folder and can’t be changed."
msgstr ""
"Isto essera utilisate pro nominar le dossier personal e non pote ser "
"cambiate."

