#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:12
msgid "Enterprise Login"
msgstr "Initio de session interprisal"

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:13
msgid ""
"Enterprise login allows an existing centrally managed user account to be "
"used on this device. You can also use this account to access company "
"resources on the internet."
msgstr ""
"Le initio de session interprisal permitte a un conto de usator gestionate de "
"maniera centralisate esser usate sur iste dispositivo. Tu anque pote usar "
"iste conto pro acceder ressources del interprisa sur le Internet."

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:26
#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:159
msgid "_Domain"
msgstr "_Dominio"

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:39
#: gnome-initial-setup/pages/account/gis-account-page-local.blp:86
msgid "_Username"
msgstr "Nomine de _usator"

