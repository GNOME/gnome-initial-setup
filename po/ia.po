msgstr "Alteres…"

#: gnome-initial-setup/pages/network/gis-network-page.c:419
msgid "Wireless networking is disabled"
msgstr "Retes sin filo es disactivate"

#: gnome-initial-setup/pages/network/gis-network-page.c:426
msgid "Checking for available wireless networks"
msgstr "Cerca de retes sin filo es in curso"

#: gnome-initial-setup/pages/network/gis-network-page.c:850
msgid "Network"
msgstr "Rete"

#: gnome-initial-setup/pages/network/gis-network-page.blp:13
msgid "Wi-Fi"
msgstr "Wi-Fi"

#: gnome-initial-setup/pages/network/gis-network-page.blp:14
msgid ""
"Connecting to the internet helps you get new apps, information, and other "
"upgrades. It also helps set the time and your location automatically."
msgstr ""
"Connecter a internet te adjuta a obtener nove applicationes, information e "
"altere actualisationes. Isso anque adjuta a definir le hora e tu "
"localisation automaticamente."

#: gnome-initial-setup/pages/network/gis-network-page.blp:55
msgid "No wireless available"
msgstr "Necun retes sin filo disponibile."

#: gnome-initial-setup/pages/network/gis-network-page.blp:68
msgid "Turn On"
msgstr "Activar"

#. Translators: The placeholder is the user’s full name.
#: gnome-initial-setup/pages/parental-controls/gis-parental-controls-page.c:106
#, c-format
