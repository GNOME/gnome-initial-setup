msgstr "Controlos parental pro %s"

#: gnome-initial-setup/pages/parental-controls/gis-parental-controls-page.c:108
msgid "Set restrictions on what this user can run or install."
msgstr "Definir restrictiones sur que pote executar o installar iste usator."

#: gnome-initial-setup/pages/parental-controls/gis-parental-controls-page.c:215
msgid "Parental Controls"
msgstr "Controlos parental"

#. Translators: The placeholder is for the user’s full name.
#: gnome-initial-setup/pages/password/gis-password-page.c:98
#, c-format
msgid "Set a Password for %s"
msgstr "Definir un contrasigno pro %s"

#: gnome-initial-setup/pages/password/gis-password-page.c:100
msgid "Be careful not to lose your password."
msgstr "Sia attente e non perdi tu contrasigno."

#: gnome-initial-setup/pages/password/gis-password-page.c:105
msgid "Set a Parent Password"
msgstr "Definir un contrasigno parente"

#. Translators: The placeholder is the full name of the child user on the system.
#: gnome-initial-setup/pages/password/gis-password-page.c:107
#, c-format
msgid "This password will control access to the parental controls for %s."
msgstr "Iste contrasigno controlara le accesso al controlos parental pro %s."

#: gnome-initial-setup/pages/password/gis-password-page.c:301
#, c-format
msgid "Password strength: %s."
msgstr "Resistentia de contrasigno: %s"

#: gnome-initial-setup/pages/password/gis-password-page.c:327
#: gnome-initial-setup/pages/password/gis-password-page.c:329
msgid "The passwords do not match."
msgstr "Le contrasignos non corresponde."

#: gnome-initial-setup/pages/password/gis-password-page.c:502
msgid "Password"
msgstr "Contrasigno"

#: gnome-initial-setup/pages/password/gis-password-page.blp:60
msgid "_Confirm Password"
msgstr "_Confirmar contrasigno"

#: gnome-initial-setup/pages/password/gis-password-page.blp:86
msgid "Password _Hint"
msgstr "_Suggestion de contrasigno"

#: gnome-initial-setup/pages/password/gis-password-page.blp:96
msgid "Password hint will be shown in case you forget your password."
msgstr ""
"Un suggestion de contrasigno essera monstrate in caso de que te oblida tu "
"contrasigno."

#: gnome-initial-setup/pages/password/pw-utils.c:81
msgctxt "Password hint"
msgid "The new password needs to be different from the old one."
msgstr "Le nove contrasigno debe esser differente del contrasigno ancian."

#: gnome-initial-setup/pages/password/pw-utils.c:83
msgctxt "Password hint"
msgid ""
"This password is very similar to your last one. Try changing some letters "
"and numbers."
msgstr ""
"Iste contrasigno es troppo simile a tu ultime. Tenta cambiar alicun litteras "
"e numeros."

#: gnome-initial-setup/pages/password/pw-utils.c:85
#: gnome-initial-setup/pages/password/pw-utils.c:93
msgctxt "Password hint"
msgid ""
"This password is very similar to your last one. Try changing the password a "
"bit more."
msgstr ""
"Iste contrasigno es troppo simile a tu ultime. Tenta cambiar le contrasigno "
"un pauc plus."

#: gnome-initial-setup/pages/password/pw-utils.c:87
msgctxt "Password hint"
msgid ""
"This is a weak password. A password without your user name would be stronger."
msgstr ""
"Iste es un contrasigno debile. Un contrasigno sin tu nomine de usator pote "
"esser plus forte."

#: gnome-initial-setup/pages/password/pw-utils.c:89
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid using your name in the password."
msgstr ""
"Iste es un contrasigno debile. Tenta evitar usar tu nomine in tu contrasigno."

#: gnome-initial-setup/pages/password/pw-utils.c:91
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to avoid some of the words included in the "
"password."
msgstr ""
"Iste es un contrasigno debile. Tenta evitar alicun del parolas includite in "
"le contrasigno."

#: gnome-initial-setup/pages/password/pw-utils.c:95
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid common words."
msgstr "Iste es un contrasigno debile, Tenta evitar le parolas commun."

#: gnome-initial-setup/pages/password/pw-utils.c:97
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid reordering existing words."
msgstr ""
"Iste es un contrasigno debile. Tenta evitar reordinar parolas existente."

#: gnome-initial-setup/pages/password/pw-utils.c:99
msgctxt "Password hint"
msgid "This is a weak password. Try to use more numbers."
msgstr "Iste es un contrasigno debile. Tenta usar plus numeros."

#: gnome-initial-setup/pages/password/pw-utils.c:101
msgctxt "Password hint"
msgid "This is a weak password. Try to use more uppercase letters."
msgstr "Iste es un contrasigno debile. Tenta usar plus litteras majuscule."

#: gnome-initial-setup/pages/password/pw-utils.c:103
msgctxt "Password hint"
msgid "This is a weak password. Try to use more lowercase letters."
msgstr "Iste es un contrasigno debile. Tenta usar plus litteras minuscule."

#: gnome-initial-setup/pages/password/pw-utils.c:105
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to use more special characters, like "
"punctuation."
msgstr ""
"Iste es un contrasigno debile. Tenta usar plus characteres special, como "
"punctuation."

#: gnome-initial-setup/pages/password/pw-utils.c:107
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to use a mixture of letters, numbers and "
"punctuation."
msgstr ""
"Iste es un contrasigno debile. Tenta usar un mixtura de litteras, numeros e "
"punctuation."

#: gnome-initial-setup/pages/password/pw-utils.c:109
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid repeating the same character."
msgstr ""
"Iste es un contrasigno debile. Tenta evitar repeter le mesme character."

#: gnome-initial-setup/pages/password/pw-utils.c:111
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to avoid repeating the same type of character: "
"you need to mix up letters, numbers and punctuation."
msgstr ""
"Iste es un contrasigno debile. Tenta evitar repeter le mesme typo de "
"character: tu necessita miscer litteras, numeros e punctuation."

#: gnome-initial-setup/pages/password/pw-utils.c:113
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid sequences like 1234 or abcd."
msgstr ""
"Iste es un contrasigno debile. Tenta evitar sequencias como 1234 o abcd."

#: gnome-initial-setup/pages/password/pw-utils.c:115
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to add more letters, numbers and punctuation."
msgstr ""
"Iste es un contrasigno debile. Tenta adder plus litteras, numeros e "
"punctuation."

#: gnome-initial-setup/pages/password/pw-utils.c:117
msgctxt "Password hint"
msgid "Mix uppercase and lowercase and try to use a number or two."
msgstr "Misce majusculas e minusculas e tenta usar un numero o duo."

#: gnome-initial-setup/pages/password/pw-utils.c:119
msgctxt "Password hint"
msgid ""
"Adding more letters, numbers and punctuation will make the password stronger."
msgstr ""
"Adder plus litteras, numeros e punctuation facera le contrasigno plus forte."

#. TRANSLATORS: this string describes a password as being poor
#: gnome-initial-setup/pages/password/pw-utils.c:146
msgid "poor"
msgstr "povre"

#. TRANSLATORS: this string describes a password as being weak
#: gnome-initial-setup/pages/password/pw-utils.c:150
msgid "weak"
msgstr "debile"

#. TRANSLATORS: this string describes a password as being strong
#: gnome-initial-setup/pages/password/pw-utils.c:154
#: gnome-initial-setup/pages/password/pw-utils.c:157
msgid "strong"
msgstr "forte"

#. TRANSLATORS: this string describes a password as being excellent
#: gnome-initial-setup/pages/password/pw-utils.c:161
msgid "excellent"
msgstr "excellente"

#. Translators: the first parameter here is the name of a distribution,
#. * like "Fedora" or "Ubuntu".
#.
#: gnome-initial-setup/pages/privacy/gis-privacy-page.c:71
#, c-format
msgid ""
"Sends technical reports that do not contain personal information. Data is "
"collected by %1$s (<a href='%2$s'>privacy policy</a>)."
msgstr ""
"Invia reportos technic que non contine information personal. Le datos es "
"colligite per %1$s (<a href='%2$s'>politica de privatessa</a>)."

#. Translators: the parameter here is the name of a distribution,
#. * like "Fedora" or "Ubuntu".
#.
#: gnome-initial-setup/pages/privacy/gis-privacy-page.c:83
#, c-format
msgid ""
"Sends technical reports that do not contain personal information. Data is "
"collected by %s."
msgstr ""
"Invia reportos technic que non contine information personal. Le datos es "
"colligite per %s."

#: gnome-initial-setup/pages/privacy/gis-privacy-page.c:126
msgid "Allows apps to determine your geographical location."
msgstr "Permitte al applicationes determinar tu localisation geographic"

#: gnome-initial-setup/pages/privacy/gis-privacy-page.c:172
#: gnome-initial-setup/pages/privacy/gis-privacy-page.blp:11
msgid "Privacy"
msgstr "Privatessa"

#: gnome-initial-setup/pages/privacy/gis-privacy-page.blp:28
msgid "Location Services"
msgstr "Servicios de localisation"

#: gnome-initial-setup/pages/privacy/gis-privacy-page.blp:57
msgid "Automatic Problem Reporting"
msgstr "Reporto automatic de problemas"

#: gnome-initial-setup/pages/privacy/gis-privacy-page.blp:85
msgid "Privacy controls can be changed at any time from the Settings app."
msgstr ""
"Le controlos de privatessa pote esser cambiate a omne momento ab le "
"application de Parametros."

#: gnome-initial-setup/pages/software/gis-software-page.c:127
#: gnome-initial-setup/pages/software/gis-software-page.blp:9
msgid "Third-Party Repositories"
msgstr "Repositorios de tertie partes"

#: gnome-initial-setup/pages/software/gis-software-page.c:129
#, c-format
msgid ""
"Third-party repositories provide access to additional software from selected "
"<a href='%s'>external sources</a>, including popular apps and drivers that "
"are important for some devices. Some proprietary software is included."
msgstr ""
"Le repositorios de tertie partes forni accesso a software additional ab <a "
"href='%s'>fontes externe</a>,seligite e include applicationes popular e "
"drivers que es importante pro alicun dispositivos. Alicun applicationes "
"proprietari es includite."

#: gnome-initial-setup/pages/software/gis-software-page.c:131
msgid ""
"Third-party repositories provide access to additional software from selected "
"external sources, including popular apps and drivers that are important for "
"some devices. Some proprietary software is included."
msgstr ""
"Le repositorios de tertie partes forni accesso a software additional ab "
"fontes externe seligite, e include applicationes popular e drivers que es "
"importante pro alicun dispositivos. Alicun software proprietari es includite."

#: gnome-initial-setup/pages/software/gis-software-page.c:143
msgid "_Disable Third-Party Repositories"
msgstr "_Disactivar repositorios de tertie partes"

#: gnome-initial-setup/pages/software/gis-software-page.c:148
msgid "_Enable Third-Party Repositories"
msgstr "Activar r_epositorios de tertie partes"

#: gnome-initial-setup/pages/summary/gis-summary-page.c:213
msgid "Setup Failed"
msgstr "Falleva le configuration"

#: gnome-initial-setup/pages/summary/gis-summary-page.c:217
#, c-format
msgid ""
