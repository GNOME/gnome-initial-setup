#: gnome-initial-setup/pages/password/gis-password-page.blp:22
msgid "_Password"
msgstr "Contra_signo"

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:109
msgid "Enterprise domain or realm name"
msgstr "Dominio de interprisa (Kerberos)"

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:132
msgid "Domain Administrator Login"
msgstr "Initio de session de administrator de dominio"

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:148
msgid ""
"In order to use enterprise logins, this computer needs to be enrolled in a "
"domain. Please have your network administrator type the domain password "
"here, and choose a unique computer name for your computer."
msgstr ""
"Pro usar le initios de session interprisal, iste computator debe esser "
"inrolate in un dominio. Demanda a tu administrator de rete scriber le "
"contrasigno de dominio hic, e elige un nomine unic de computator pro tu "
"computator."

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:186
msgid "_Computer"
msgstr "_Computator"

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.blp:211
